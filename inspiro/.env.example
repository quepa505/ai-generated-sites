# --- Claude API (wymagane do analizy, pomysłów i czatu) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model (domyślnie claude-opus-5-5). Do taniej analizy setek zakładek możesz ustawić
# INSPIRO_ANALYSIS_MODEL=claude-haiku-5-5 albo claude-sonnet-5-5.
# INSPIRO_MODEL=claude-opus-5-5
# INSPIRO_ANALYSIS_MODEL=claude-opus-5-5
# INSPIRO_ANALYSIS_EFFORT=low       # low | medium | high
# INSPIRO_CHAT_EFFORT=medium
# INSPIRO_IDEAS_EFFORT=high
# INSPIRO_ANALYSIS_CONCURRENCY=3
# INSPIRO_WEB_SEARCH=0              # 1 = agent w czacie może szukać w internecie
# INSPIRO_SERVER_FALLBACK=1         # automatyczny model zastępczy przy odmowie

# --- Reddit API (opcjonalnie; wymaga zatwierdzonego dostępu do Data API) ---
# Aplikacja typu "script": https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# REDDIT_USER_AGENT=inspiro/0.1 by u/twoj_login

# --- X API (opcjonalnie; OAuth 2.0 PKCE, pay-per-use) ---
X_CLIENT_ID=
# X_CLIENT_SECRET=                  # tylko dla "confidential client"
# X_REDIRECT_URI=http://127.0.0.1:8000/auth/x/callback

# --- Serwer ---
# INSPIRO_DB=data/inspiro.db
# INSPIRO_PASSWORD=                 # ustaw, jeśli wystawiasz aplikację poza localhost
